{
  "name": "iac-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "gen:types": "scripts/gen-types.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
